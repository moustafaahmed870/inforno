rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Menu items — everyone can read, only admins can write
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Homepage / editable site text & image — everyone can read, only admins can write
    match /siteContent/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders — anyone can create one, and can read a SPECIFIC order if they
    // already know its id (used by the customer tracking page: a "get" of one
    // document). Listing/browsing the whole collection stays admin-only.
    match /orders/{id} {
      allow create: if true;
      allow get: if true;
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Admin allowlist — a doc must be manually created here (id = the user's Firebase Auth UID)
    // for that account to be treated as an admin anywhere in the app.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // manage from the Firebase Console only
    }

    // Upload rate-limit counters — written only by the /api/upload serverless
    // function via the Firebase Admin SDK (which bypasses these rules entirely).
    // No client should ever read or write this collection directly.
    match /rateLimits/{uid} {
      allow read, write: if false;
    }
  }
}
